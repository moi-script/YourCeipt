<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 forces edge-to-edge, which puts the web page under the
         status bar. Opt out so the WebView starts below it like on older phones. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#f7f6f2</item>
        <item name="android:navigationBarColor">#f7f6f2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
